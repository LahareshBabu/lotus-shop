# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ============================================
# DEPENDENCIES
# ============================================
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Python virtual environments
venv/
env/
ENV/
.venv/

# ============================================
# TESTING
# ============================================
/coverage
.pytest_cache/
.coverage
htmlcov/
*.cover

# ============================================
# BUILD OUTPUTS
# ============================================
# Next.js
/.next/
/out/
/build

# Python
dist/
*.egg-info/
__pycache__/
*.py[cod]
*$py.class
*.so

# ============================================
# ENVIRONMENT VARIABLES (CRITICAL SECURITY)
# ============================================
.env*
!.env.example
!.env.sample

# Alternative env file patterns
*.env
local.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ============================================
# SECRETS & CREDENTIALS
# ============================================
*.pem
*.key
*.cert
*.p12
secrets.json
credentials.json

# ============================================
# DEPLOYMENT
# ============================================
.vercel
.netlify

# ============================================
# LOGS
# ============================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ============================================
# OS & EDITOR FILES
# ============================================
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ============================================
# TYPESCRIPT
# ============================================
*.tsbuildinfo
next-env.d.ts

# ============================================
# TEMPORARY FILES
# ============================================
*.tmp
*.temp
.cache/

# ============================================
# LARGE DATASETS (PREVENT BLOB BLOAT)
# ============================================
*.json.gz
*.csv
reviews_Clothing_Shoes_and_Jewelry_5.json.gz